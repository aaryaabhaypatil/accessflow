{
    "manifest_version": 2,
    "name": "Eye Tracking Example",
    "description": "A simple eye-tracking extension using WebGazer.js",
    "version": "1.0",
    "permissions": [
      "activeTab",
      "webNavigation",
      "tabs",
      "storage",
      "camera",
      "http://localhost/*",
      "https://localhost/*"
    ],
    "background": {
      "scripts": ["background.js"],
      "persistent": false
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_end"
        
      }
    ],
    "web_accessible_resources": [
      "webgazer.js"
    ]
  }
  