{
  "manifest_version": 3,
  "name": "Eye Tracking Example",
  "description": "A simple eye-tracking extension using WebGazer.js",
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost/*",
    "https://localhost/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "landing.html",
    "default_title": "Eye Tracker"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["webgazer.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["webgazer.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self'"
  }
}